# Copy to .env.local and edit. Vite only exposes vars prefixed with VITE_.

# Data source. "true" = in-memory mock. "false" = real API via VITE_API_BASE_URL.
VITE_USE_MOCK=true

# Auth source. "true" = fake local sign-in. "false" = Cognito via Amplify.
VITE_USE_MOCK_AUTH=true

# --- Fill these in when the backend exists ---
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_AWS_REGION=eu-west-2
